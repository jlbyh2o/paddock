# ft-man's web interface as a system service, running as the user who owns the FreeToken
# install so that config, state, profiles and the engine's log files land in that user's
# normal XDG locations.
#
#   sudo install -m644 contrib/ft-man-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ft-man-web
#
# Edit User= (and HF_HOME below, if the Hugging Face cache lives somewhere other than the
# default) before installing.

[Unit]
Description=ft-man web interface
Documentation=https://github.com/jlbyh2o/ft-man-tui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jeremy
Group=jeremy
# ft-man reads its config from ~/.config/ft-man and keeps state under ~/.local/state.
# The listen address comes from [web] listen in that config; pass --listen here to
# override it for this unit only.
ExecStart=/home/jeremy/.local/bin/ft-man web
WorkingDirectory=/home/jeremy
# What an interactive login would export from /etc/profile.d: the shared model dataset,
# so that anything ft-man spawns (the engine, `hf download`) resolves the same cache.
Environment=HF_HOME=/workspace/huggingface
Environment=PATH=/home/jeremy/.local/bin:/usr/local/bin:/usr/bin:/bin
# Diagnostics go to the journal as well as ~/.local/state/ft-man/logs/ft-man.log.
Environment=FT_MAN_LOG=info
Restart=on-failure
RestartSec=3

# The engine runs in its own session under this daemon. Stopping or restarting the web
# service must not take a loaded model down with it: signal only the daemon itself, and
# let it re-adopt the engine when it comes back.
KillMode=process
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
